load("@rules_go//go:def.bzl", "go_binary", "go_cross_binary", "go_library")

go_library(
    name = "ffwd-usbfs_lib",
    srcs = [
        "main.go",
        "privileges.go",
    ],
    importpath = "github.com/filmil/usbfs-fido-relay/cmd/ffwd-usbfs",
    visibility = ["//visibility:private"],
    deps = [
        "//ctaphid",
        "//relay",
        "//usbfs",
    ],
)

go_binary(
    name = "ffwd-usbfs",
    embed = [":ffwd-usbfs_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

# usbfs exists only on Linux, so the relay is built for Linux only.
[
    go_cross_binary(
        name = "ffwd-usbfs_" + plat,
        platform = "@rules_go//go/toolchain:" + plat,
        target = ":ffwd-usbfs",
        visibility = ["//visibility:public"],
    )
    for plat in [
        "linux_amd64",
        "linux_arm64",
    ]
]
