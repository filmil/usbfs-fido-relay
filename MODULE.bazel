module(
    name = "yubikey_forward",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

# The paper; from the custom registry (filmil/bazel-registry), see .bazelrc.
bazel_dep(name = "rules_latex_host", version = "0.3.1")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.3")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_fxamacker_cbor_v2", "com_github_inconshreveable_mousetrap", "com_github_spf13_cobra", "com_github_spf13_pflag", "com_github_txomon_fido_forward", "com_github_x448_float16", "com_rafaelmartins_p_usbhid", "org_golang_x_sys")

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_toolchains("@zig_sdk//toolchain:linux_amd64_gnu.2.31")

